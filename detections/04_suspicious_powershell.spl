# Detection 04 - PowerShell abuse (encoded commands, download cradles, hidden window) | MITRE T1059.001, T1027, T1105
# Needs: Sysmon (Event ID 1) and/or PowerShell Script Block Logging (Event ID 4104)
# Alert: every 5 min, last 10 min, trigger if results > 0
(index=sysmon EventCode=1 Image="*\\powershell.exe"
    (CommandLine="*-enc*" OR CommandLine="*-EncodedCommand*" OR CommandLine="*FromBase64String*" OR CommandLine="*DownloadString*" OR CommandLine="*Invoke-Expression*" OR CommandLine="* IEX*" OR CommandLine="*-w hidden*" OR CommandLine="*-nop*"))
OR (index=powershell EventCode=4104
    (ScriptBlockText="*DownloadString*" OR ScriptBlockText="*FromBase64String*" OR ScriptBlockText="*Invoke-Expression*"))
| eval cmd=coalesce(CommandLine, ScriptBlockText)
| table _time Computer User ParentImage cmd
| sort - _time
