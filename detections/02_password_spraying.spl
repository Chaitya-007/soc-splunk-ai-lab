# Detection 02 - Password spraying (few attempts per user, many users, one source) | MITRE T1110.003
# Alert: every 10 min, last 15 min, trigger if results > 0
index=wineventlog EventCode=4625 earliest=-15m
| stats count AS failures dc(TargetUserName) AS distinct_users values(TargetUserName) AS users BY IpAddress Computer
| eval avg_per_user=round(failures/distinct_users,1)
| where distinct_users>=5 AND avg_per_user<=3
